{
  "title": "פינה בלב",
  "artist": "oriasomech",
  "sections": [
    {
      "id": "intro",
      "label": "פתיחה",
      "start": 0,
      "lines": []
    },
    {
      "id": "verse1",
      "label": "בית 1",
      "start": 12,
      "lines": [
        "עוד ערב יורד על העיר",
        "ואת כבר לא כאן",
        "מזמן כבר לא כאן",
        "וכבר לא מאמינה לאף אחד",
        "אמרו לי \"תשכח, תמשיך הלאה\"",
        "כאילו זה פשוט, כאילו זה יאללה סע הלאה",
        "עברתי כבר אלף לילות בלעדייך",
        "אף אחת לא מרגישה כמוך בכלל"
      ]
    },
    {
      "id": "chorus1",
      "label": "פזמון",
      "start": 60,
      "lines": [
        "שיהיה לך רק טוב, רק טוב",
        "גם אם לי זה עוד כואב",
        "שתמצאי אחד ששומר עלייך",
        "אחד שלא עוזב",
        "ואם עוד פעם תתגעגעי",
        "את יודעת איפה אני",
        "מקווה שיש אצלך פינה בלב",
        "פינה בלב בשבילי"
      ]
    },
    {
      "id": "verse2",
      "label": "בית 2",
      "start": 90,
      "lines": [
        "שואלים \"מה נשמע\"",
        "משחק אותה, מרגיש שהכול בסדר",
        "אבל השלווה יורדת",
        "אני עוד שומע את הצחוק שלך בחדר",
        "שנינו יודעים שניסינו הכול",
        "זוכר ימים שצחקנו בקול",
        "אז אני מרים כוסית לשכוח",
        "והלוואי שהיית פה איתי, חיים שלי, הלוואי רק תבואי"
      ]
    },
    {
      "id": "chorus2",
      "label": "פזמון",
      "start": 112,
      "lines": [
        "שיהיה לך רק טוב, רק טוב",
        "גם אם לי זה עוד כואב",
        "שתמצאי אחד ששומר עלייך",
        "אחד שלא עוזב",
        "ואם פעם תתגעגעי",
        "תדעי איפה אני",
        "באותה פינה בלב שלך",
        "ששמרת בשבילי"
      ]
    },
    {
      "id": "drop",
      "label": "דרופ",
      "start": 132,
      "lines": []
    },
    {
      "id": "outro",
      "label": "סיום",
      "start": 140,
      "lines": [
        "שיהיה לך רק טוב... רק טוב...",
        "תחזרי, חיים שלי"
      ]
    }
  ]
}
